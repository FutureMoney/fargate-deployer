{
  "name": "fargate-deployer",
  "version": "1.1.0",
  "description": "Deploy containers to AWS ECS Fargate from a declarative manifest — long-running services behind an ALB, or EventBridge-scheduled tasks.",
  "keywords": [
    "aws",
    "ecs",
    "fargate",
    "cdk",
    "deploy",
    "github-actions",
    "alb",
    "eventbridge"
  ],
  "license": "MIT",
  "author": "FutureMoney",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futuremoney/fargate-deployer.git"
  },
  "homepage": "https://github.com/futuremoney/fargate-deployer#readme",
  "bugs": {
    "url": "https://github.com/futuremoney/fargate-deployer/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fargate-deployer": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w",
    "clean": "rm -rf dist",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "aws-cdk": "^2.1029.0",
    "aws-cdk-lib": "^2.190.0",
    "constructs": "^10.4.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "ajv": "^8.17.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.3.2",
    "typescript": "~7.0.2"
  }
}
